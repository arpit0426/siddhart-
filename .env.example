# NearBuy environment configuration.
# Copy to `.env` and adjust per environment. Never commit real secrets.
# On a hosting platform, set these in the provider's environment/secrets panel.

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public https URL of the deployment (used for origin checks and logs).
APP_URL=
# Extra comma-separated origins allowed to make state-changing requests, e.g.
# ALLOWED_ORIGINS=https://nearbuy.example.com,https://staging.nearbuy.example.com
ALLOWED_ORIGINS=

# Honour X-Forwarded-* headers from a reverse proxy / load balancer.
TRUST_PROXY=true

# --- Database ---------------------------------------------------------------
# SQLite file. Use a persistent volume in production, e.g. /data/nearbuy.db
DATABASE_FILE=data/nearbuy.db

# --- Sessions ---------------------------------------------------------------
# Session cookie lifetime in days.
SESSION_TTL_DAYS=30
# Mark the session cookie Secure. Keep true in production (HTTPS only).
# COOKIE_SECURE=true

# --- Password recovery ------------------------------------------------------
# Password-reset tokens are single-use and expire after this many minutes.
RESET_TOKEN_TTL_MINUTES=30

# --- Demo / staging accounts ------------------------------------------------
# Demo accounts (customer.demo@ / seller.demo@ / rider.demo@nearbuy.app) are
# DEMO/STAGING ONLY. Outside production demo mode defaults to on; in production
# it stays OFF unless ENABLE_DEMO_ACCOUNTS=true is set explicitly.
DEMO_MODE=true
# ENABLE_DEMO_ACCOUNTS=true

# --- Business rules ---------------------------------------------------------
DELIVERY_FEE_PER_STORE=30
# Subtotal at/above which delivery is free (0 disables free delivery).
FREE_DELIVERY_THRESHOLD=0
RESERVATION_HOLD_HOURS=24
LOW_STOCK_THRESHOLD=5

# --- Uploads ----------------------------------------------------------------
UPLOADS_DIR=data/uploads
MAX_UPLOAD_BYTES=4194304

# --- Logging ----------------------------------------------------------------
# info | debug (secrets are always redacted from logs)
LOG_LEVEL=info
