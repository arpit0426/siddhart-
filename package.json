{
  "name": "nearbuy",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --logLevel warn && tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "db:seed": "tsx server/seed.ts",
    "test": "npm run test:unit && npm run test:api && npm run test:portal && npm run test:e2e && npm run test:dom && npm run test:live && npm run test:ui && npm run test:postlogin && npm run test:routing",
    "test:postlogin": "tsx server/tests/postlogin.test.tsx",
    "test:unit": "tsx server/tests/unit.test.ts",
    "test:api": "tsx server/tests/api.test.ts",
    "test:portal": "tsx server/tests/portal.test.ts",
    "test:e2e": "tsx server/tests/e2e.test.ts",
    "test:live": "tsx server/tests/live.test.tsx",
    "test:ui": "tsx server/tests/ui.test.tsx",
    "test:routing": "tsx server/tests/routing.test.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:dom": "tsx server/tests/dom.test.tsx",
    "db:seed:prod": "NODE_ENV=production tsx server/seed.ts",
    "dev:hmr": "USE_VITE=true tsx server.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "description": "NearBuy - neighbourhood commerce platform (customers, sellers, delivery riders)",
  "engines": {
    "node": ">=22.5.0"
  }
